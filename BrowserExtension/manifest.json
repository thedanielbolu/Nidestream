{
  "manifest_version": 3,
  "name": "Nidestream Integration",
  "short_name": "Nidestream",
  "version": "1.0.0",
  "description": "Send downloads, links and videos to the Nidestream download manager for macOS.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Nidestream",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "permissions": ["downloads", "contextMenus", "webRequest", "cookies", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "integration@nidestream.app",
      "strict_min_version": "121.0"
    }
  }
}
